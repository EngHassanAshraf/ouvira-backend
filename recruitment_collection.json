						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"var results = jsonData.results || jsonData;",
									"var ad = results.find(a => a.hiring_request === parseInt(pm.environment.get(\"hiring_request_id\")));",
									"if (ad) pm.environment.set(\"ad_id\", ad.id);"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [
