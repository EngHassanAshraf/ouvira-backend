						"body": {
							"mode": "raw",
							"raw": "{\n    \"company\": {{company_id}},\n    \"job_title\": {{job_title_id}},\n    \"department\": {{dept_id}},\n    \"vacancies\": 1,\n    \"purpose\": \"Verification via Postman\"\n}",
