				{
					"name": "List Companies",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"var company = jsonData.results ? jsonData.results.find(c => c.name === \"Shawahid Test Co\") : jsonData.find(c => c.name === \"Shawahid Test Co\");",
									"if (company) pm.environment.set(\"company_id\", company.id);"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [
							{ "key": "X-Tenant", "value": "{{tenant}}", "type": "text" },
							{ "key": "Authorization", "value": "Bearer {{access_token}}", "type": "text" }
						],
						"url": { "raw": "{{base_url}}/api/company/", "host": ["{{base_url}}"], "path": ["api", "company", ""] }
					}
				},
